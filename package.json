{
  "name": "react-native-alpha-video",
  "version": "1.0.0",
  "description": "Transparent video for React Native: VP9 WebM with alpha on iOS and Android, decoded by a C++ core (FFmpeg + libvpx) or the Android hardware decoder, drawn with Metal and OpenGL ES. Falls back to <video> on the web.",
  "source": "react-native/src/index.tsx",
  "main": "lib/commonjs/index.js",
  "module": "lib/module/index.js",
  "types": "lib/typescript/react-native/src/index.d.ts",
  "react-native": "react-native/src/index.tsx",
  "files": [
    "react-native",
    "lib",
    "cpp",
    "ios",
    "android",
    "scripts",
    "prebuilt",
    "react-native-alpha-video.podspec",
    "react-native.config.js",
    "THIRD_PARTY_NOTICES.md",
    "licenses",
    "!scripts/build",
    "!**/__tests__",
    "!**/__fixtures__",
    "!**/__mocks__",
    "!android/build",
    "!android/.gradle",
    "!android/.cxx",
    "!android/local.properties",
    "!react-native/android/build",
    "!react-native/android/.gradle",
    "!react-native/android/.cxx",
    "!android/gradle",
    "!android/gradlew",
    "!android/gradlew.bat",
    "!prebuilt/FFmpegVPX.xcframework",
    "!prebuilt/FFmpegVPX.xcframework.zip",
    "!ios/build",
    "!.DS_Store"
  ],
  "scripts": {
    "build": "bob build",
    "typescript": "tsc --noEmit",
    "lint": "eslint \"**/*.{js,ts,tsx}\"",
    "prepare": "bob build",
    "prepack": "bob build",
    "build:ffmpeg:ios": "cd scripts && ./build_ffmpeg_ios.sh",
    "build:ffmpeg:ios:device": "cd scripts && ./build_ffmpeg_ios_device.sh",
    "build:ffmpeg:ios:simulator": "cd scripts && ./build_ffmpeg_ios_simulator.sh",
    "build:ffmpeg:android": "cd scripts && ./build_ffmpeg_android.sh",
    "build:ffmpeg:all": "npm run build:ffmpeg:ios && npm run build:ffmpeg:android",
    "build:xcframework": "scripts/build_xcframework.sh",
    "publish:android:local": "scripts/publish-android.sh local",
    "fetch:prebuilt": "scripts/fetch-prebuilt.sh",
    "package:release": "scripts/package_release.sh"
  },
  "keywords": [
    "react-native",
    "alpha",
    "transparent-video",
    "transparency",
    "webm",
    "vp9",
    "video",
    "player",
    "ffmpeg",
    "ios",
    "android",
    "react-native-web",
    "metal",
    "opengl"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/danielkpl2/alpha-video.git"
  },
  "author": "Daniel Kasprowicz",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/danielkpl2/alpha-video/issues"
  },
  "homepage": "https://github.com/danielkpl2/alpha-video#readme",
  "codegenConfig": {
    "name": "RNAlphaVideoSpec",
    "type": "all",
    "jsSrcsDir": "react-native/src",
    "android": {
      "javaPackageName": "dev.mediacache.alphavideo.reactnative"
    },
    "ios": {
      "componentProvider": {
        "RNAlphaVideoView": "RNAlphaVideoViewComponentView"
      }
    }
  },
  "publishConfig": {
    "registry": "https://registry.npmjs.org/"
  },
  "devDependencies": {
    "@babel/preset-env": "^7.28.5",
    "@babel/preset-react": "^7.28.5",
    "@babel/preset-typescript": "^7.28.5",
    "@types/react": "^18.2.0",
    "@types/react-native": "^0.72.0",
    "react": "^18.2.0",
    "react-native": "^0.73.0",
    "react-native-builder-bob": "^0.23.0",
    "typescript": "^5.0.0"
  },
  "peerDependencies": {
    "react": "*",
    "react-native": "*"
  },
  "peerDependenciesMeta": {
    "react-native-web": {
      "optional": true
    }
  },
  "react-native-builder-bob": {
    "source": "react-native/src",
    "output": "lib",
    "targets": [
      [
        "commonjs",
        {
          "configFile": true
        }
      ],
      [
        "module",
        {
          "configFile": true
        }
      ],
      [
        "typescript",
        {
          "project": "tsconfig.build.json"
        }
      ]
    ]
  }
}
